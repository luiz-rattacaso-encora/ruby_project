<div class="app-container">

  <header class="page-header">
    <div>
      <h1 class="page-title">Hi <%= @user&.name || "Guest" %>! Welcome to Home Page</h1>
      <p class="page-subtitle">Workspace overview and quick navigation</p>
    </div>
  </header>

  <div class="nav-grid">
    <%= link_to "/employees/all", class: "nav-card" do %>
      <div>
        <h2 class="nav-card-title">Employees</h2>
        <p class="nav-card-desc">Browse the company directory, roles, and reporting hierarchies.</p>
      </div>
      <span class="nav-card-action">List of Employees →</span>
    <% end %>

    <%= link_to "/teams", class: "nav-card" do %>
      <div>
        <h2 class="nav-card-title">Teams</h2>
        <p class="nav-card-desc">Explore departments, tech stacks, and team weekly updates.</p>
      </div>
      <span class="nav-card-action">List of Teams →</span>
    <% end %>

    <%= link_to "/memberships", class: "nav-card" do %>
      <div>
        <h2 class="nav-card-title">Memberships</h2>
        <p class="nav-card-desc">Manage employee assignments and active team allocations.</p>
      </div>
      <span class="nav-card-action">See memberships →</span>
    <% end %>

    <%= link_to "/announcements", class: "nav-card" do %>
      <div>
        <h2 class="nav-card-title">Announcements</h2>
        <p class="nav-card-desc">Publish company-wide updates and read recent team news.</p>
      </div>
      <span class="nav-card-action">Set an announcement →</span>
    <% end %>
  </div>
</div>