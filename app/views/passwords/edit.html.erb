<% content_for :title, "New password" %>

<div class="app-container auth-container">
  <header class="page-header">
    <div>
      <h1 class="page-title">Choose a new password</h1>
      <p class="page-subtitle">You will be asked to sign in again afterwards</p>
    </div>
  </header>
  <div class="form-card">
    <%= form_with url: password_path(params[:token]), method: :put do |form| %>
      <div class="form-group">
        <%= form.label :password, "New password" , class: "form-label" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password" , maxlength: 72,
            class: "formcontrol" %>
      </div>
      <div class="form-group">
        <%= form.label :password_confirmation, "Repeat new password" , class: "form-label" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" , maxlength:
            72, class: "form-control" %>
      </div>
      <div class="form-actions">
        <%= form.submit "Save" , class: "btn btn-primary" %>
      </div>
      <% end %>
  </div>
</div>