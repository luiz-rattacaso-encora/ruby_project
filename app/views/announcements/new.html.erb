<div style="max-width: 700px; margin: 2rem auto; font-family: sans-serif; color: #212529;">
  <div style="margin-bottom: 1.25rem;">
    <%= link_to "← Voltar para o Mural", announcements_path, style: "color: #0d6efd; text-decoration: none; font-size: 0.95rem;" %>
  </div>

  <div style="background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 2rem;">
    <h1 style="margin-top: 0; margin-bottom: 0.25rem; font-size: 1.5rem;">Novo Aviso no Mural</h1>
    <p style="margin-top: 0; margin-bottom: 1.5rem; color: #6c757d; font-size: 0.95rem;">
      Selecione um dos times vinculados ao seu perfil para publicar o comunicado.
    </p>

    <%= render "form", announcement: @announcement %>
  </div>
</div>