<div style="max-width: 860px; margin: 2rem auto; font-family: sans-serif; color: #212529;">

  <div class="breadcrumb-nav">
    <%= link_to "← Back to Main page", "/" %>
  </div>

  <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <div>
      <h1 style="margin: 0; font-size: 1.75rem;">Announcement Board</h1>
      <p style="margin: 0.25rem 0 0; color: #6c757d; font-size: 0.95rem;">Company updates and team news</p>
    </div>

    <% if AnnouncementPolicy.new(Current.user).can_access_new_form? %>
      <%= link_to "+ New Announcement", new_announcement_path,
          style: "background: #0d6efd; color: #fff; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-weight: bold;" %>
    <% end %>
  </header>

  <section style="background: #f8f9fa; padding: 1rem; border-radius: 8px; border: 1px solid #e9ecef; margin-bottom: 1.75rem;">
    <%= form_with url: announcements_path, method: :get, local: true, style: "display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: flex-end;" do |f| %>
      <div style="flex: 1; min-width: 180px;">
        <%= f.label :team_id, "Filter by team", style: "display: block; font-size: 0.85rem; color: #495057; margin-bottom: 0.3rem;" %>
        <%= f.select :team_id,
            options_from_collection_for_select(Team.order(:name), :id, :name, params[:team_id]),
            { include_blank: "All teams" },
            { style: "width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 6px; background: #fff;" } %>
      </div>

      <div style="flex: 1; min-width: 200px;">
        <%= f.label :author_name, "Search by author", style: "display: block; font-size: 0.85rem; color: #495057; margin-bottom: 0.3rem;" %>
        <%= f.text_field :author_name, value: params[:author_name], placeholder: "Employee name...",
            style: "width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 6px; box-sizing: border-box;" %>
      </div>

      <div style="display: flex; gap: 0.5rem;">
        <%= f.submit "Filter", style: "background: #212529; color: #fff; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer;" %>
        <% if params[:team_id].present? || params[:author_name].present? %>
          <%= link_to "Clear", announcements_path, style: "padding: 8px 12px; color: #6c757d; text-decoration: none;" %>
        <% end %>
      </div>
    <% end %>
  </section>

  <% if @announcements.any? %>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <% @announcements.each do |announcement| %>
        <article style="background: #fff; border: 1px solid #dee2e6; border-radius: 8px; padding: 1.5rem; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <span style="background: #e7f1ff; color: #0d6efd; font-size: 0.8rem; font-weight: bold; padding: 4px 10px; border-radius: 999px;">
              <%= announcement.team&.name || "General Announcement" %>
            </span>

            <time style="font-size: 0.85rem; color: #6c757d;">
              <%= l(announcement.created_at, format: :short) %>
            </time>
          </div>

          <h2 style="margin: 0 0 0.75rem; font-size: 1.25rem;">
            <%= link_to announcement.title, announcement_path(announcement), style: "color: #212529; text-decoration: none;" %>
          </h2>

          <div style="color: #495057; line-height: 1.6; margin-bottom: 1.25rem;">
            <%= simple_format(truncate(announcement.content, length: 300)) %>
          </div>

          <footer style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f3f5; padding-top: 0.85rem; font-size: 0.875rem; color: #6c757d;">
            <span>Posted by <strong><%= announcement.author.name %></strong></span>

            <div style="display: flex; gap: 1rem; align-items: center;">
              <%= link_to "Read more", announcement_path(announcement), style: "color: #0d6efd; text-decoration: none;" %>

              <% if AnnouncementPolicy.new(Current.user, announcement: announcement).can_modify? %>
                <%= link_to "Edit", edit_announcement_path(announcement), style: "color: #495057; text-decoration: none;" %>
                <%= button_to "Delete", announcement_path(announcement),
                    method: :delete,
                    form: { style: "display: inline;", data: { turbo_confirm: "Are you sure you want to delete this announcement?" } },
                    style: "background: none; border: none; color: #dc3545; cursor: pointer; padding: 0; font-size: 0.875rem;" %>
              <% end %>
            </div>
          </footer>
        </article>
      <% end %>
    </div>
  <% else %>
    <div style="text-align: center; padding: 3rem 1rem; background: #f8f9fa; border-radius: 8px; border: 1px dashed #ced4da; color: #6c757d;">
      <p style="margin: 0 0 0.5rem; font-size: 1.1rem;">No announcements found.</p>
      <small>Try adjusting your filters or post the first announcement to the board.</small>
    </div>
  <% end %>
</div>