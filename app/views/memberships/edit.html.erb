<div class="app-container">
  <div class="breadcrumb-nav">
    <%= link_to "← Back to Memberships", memberships_path %>
  </div>

  <header class="page-header">
    <div>
      <h1 class="page-title"><%= @membership.persisted? ? "Edit Membership" : "Add Employee to a Team" %></h1>
      <p class="page-subtitle">Update employee and team assignment details</p>
    </div>
  </header>

  <div class="form-card">
    <%= form_with model: @membership, data: { turbo: false } do |f| %>
      <% if @membership.errors.any? %>
        <div class="error-summary">
          <h4 class="error-summary-title">Oops! Something went wrong here:</h4>
          <ul>
            <% @membership.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :employee_id, "Select Employee", class: "form-label" %>
        <%= f.collection_select :employee_id, Employee.all, :id, :full_name_with_role,
            { include_blank: "Select an employee..." },
            { class: "form-control" } %>
      </div>

      <div class="form-group">
        <%= f.label :team_id, "Select Team", class: "form-label" %>
        <%= f.collection_select :team_id, Team.all, :id, :name,
            { include_blank: "Select a team..." },
            { class: "form-control" } %>
      </div>

      <div class="form-actions">
        <%= f.submit @membership.persisted? ? "Save Changes" : "Create Membership", class: "btn btn-primary" %>
        <%= link_to "Cancel", memberships_path, class: "link-muted" %>
      </div>
    <% end %>
  </div>
</div>