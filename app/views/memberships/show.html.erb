<div class="app-container">
  <div class="breadcrumb-nav">
    <%= link_to "← Back to Memberships", memberships_path %>
  </div>

  <header class="page-header">
    <div>
      <h1 class="page-title">Membership Details</h1>
      <p class="page-subtitle">Assignment record #<%= @membership.id %></p>
    </div>

    <div class="header-actions">
      <%= link_to "Edit", edit_membership_path(@membership), class: "btn btn-dark" %>
      <% unless @membership.finished_at.present? %>
        <%= button_to "Finish Membership", membership_path(@membership),
            method: :delete,
            form: { style: "display: inline;" },
            data: { turbo_confirm: "Are you sure you want to finish this membership?" },
            class: "btn btn-danger-outline" %>
      <% end %>
    </div>
  </header>

  <article class="card">
    <div class="detail-list">
      <div class="detail-row">
        <span class="detail-label">Employee</span>
        <span class="detail-value"><%= @membership.employee.full_name_with_role %></span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Team</span>
        <div>
          <span class="badge badge-primary" style="font-size: 0.9rem;"><%= @membership.team.name %></span>
        </div>
      </div>

      <div class="detail-row">
        <span class="detail-label">Joined At</span>
        <span class="detail-value"><%= @membership.created_at.strftime("%B %d, %Y %I:%M %p") %></span>
      </div>

      <% if @membership.finished_at.present? %>
        <div class="detail-row">
          <span class="detail-label">Finished At</span>
          <span class="detail-value"><%= @membership.finished_at.strftime("%B %d, %Y %I:%M %p") %></span>
        </div>
      <% end %>
    </div>
  </article>
</div>