<h1>Memberships List</h1>

<% if flash[:notice] %>
  <div style="color: green; margin-bottom: 10px;"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div style="color: red; margin-bottom: 10px;"><%= flash[:alert] %></div>
<% end %>

<%= link_to "New Membership", "/memberships/new", style: "display: inline-block; margin-bottom: 15px;" %>

<table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse; text-align: left;">
  <thead>
    <tr style="background-color: #f2f2f2;">
      <th>Employee</th>
      <th>Team</th>
      <th>Status / Finished at</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @memberships.each do |membership| %>
      <tr>
        <td>
          <%= membership.employee.respond_to?(:full_name) ? membership.employee.full_name : "#{membership.employee.first_name} #{membership.employee.last_name}" %>
        </td>
        
        <td><%= membership.team.name %></td>
        
        <td>
          <% if membership.respond_to?(:finished_at) && membership.finished_at.present? %>
            <span style="color: red;">Finished at: <%= membership.finished_at.strftime("%d/%m/%Y %H:%M") %></span>
          <% else %>
            <span style="color: green; font-weight: bold;">Active</span>
          <% end %>
        </td>
        
        <td>
          <%= link_to "Editar", edit_membership_path(membership) %> | 
          
          <% if membership.respond_to?(:finished_at) && membership.finished_at.nil? %>
            <%= link_to "Finish", membership_path(membership), data: { turbo_method: :delete, turbo_confirm: "Are you sure about finish the link between employee and team?" }, style: "color: red;" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
