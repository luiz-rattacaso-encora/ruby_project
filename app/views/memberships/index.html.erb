<div class="app-container">
  <% if flash[:notice] %>
    <div class="alert alert-notice"><%= flash[:notice] %></div>
  <% end %>

  <% if flash[:alert] %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>

  <div class="breadcrumb-nav">
    <%= link_to "← Back to Home", "/" %>
  </div>

  <header class="page-header">
    <div>
      <h1 class="page-title">Memberships</h1>
      <p class="page-subtitle">Manage employee team assignments and active memberships</p>
    </div>

    <div class="header-actions">
      <%= link_to "+ New Membership", new_membership_path, class: "btn btn-primary" %>
    </div>
  </header>

  <section class="filter-box">
    <%= form_with url: memberships_path, method: :get, local: true, class: "filter-form" do |form| %>
      <div style="flex: 1; min-width: 220px;">
        <%= form.label :search_name, "Search by employee name", class: "form-label" %>
        <%= form.text_field :search_name, value: params[:search_name], placeholder: "Type an employee name...", class: "form-control" %>
      </div>

      <div class="header-actions">
        <%= form.submit "Search", class: "btn btn-dark" %>
        <% if params[:search_name].present? %>
          <%= link_to "Clear", memberships_path, class: "link-muted" %>
        <% end %>
      </div>
    <% end %>
  </section>

  <% if @memberships.any? %>
    <div class="table-card">
      <table class="data-table">
        <thead>
          <tr>
            <th>Employee</th>
            <th>Team</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @memberships.each do |membership| %>
            <tr>
              <td>
                <%= link_to "#{membership.employee.first_name} #{membership.employee.last_name}",
                    membership_path(membership),
                    class: "link-primary" %>
              </td>

              <td>
                <span class="badge badge-primary"><%= membership.team.name %></span>
              </td>

              <td>
                <% if membership.finished_at.present? %>
                  <span class="badge badge-neutral">Finished</span>
                <% else %>
                  <span class="badge" style="background: #d1e7dd; color: #0f5132;">Active</span>
                <% end %>
              </td>

              <td>
                <div class="table-actions">
                  <%= link_to "Edit", edit_membership_path(membership), class: "btn btn-outline btn-sm" %>

                  <% unless membership.finished_at.present? %>
                    <%= button_to "Finish Membership", membership_path(membership),
                        method: :delete,
                        form: { style: "display: inline;" },
                        data: { turbo_confirm: "Are you sure you want to finish this membership?" },
                        class: "btn btn-danger-outline btn-sm" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <p>No memberships found.</p>
      <small>Try adjusting your search or create a new team membership.</small>
    </div>
  <% end %>
</div>