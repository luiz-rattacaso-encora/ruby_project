<h1>Memberships List</h1>

<% if flash[:notice] %>
  <div style="color: green; margin-bottom: 10px;"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div style="color: red; margin-bottom: 10px;"><%= flash[:alert] %></div>
<% end %>

<%= link_to "New Membership", new_membership_path, style: "display: inline-block; margin-bottom: 15px;" %>

<%= form_with url: memberships_path, method: :get, local: true do |form| %>
  <div style="margin-bottom: 20px;">
    <%= form.label :search_name, "Search by employee name:", style: "display: block; margin-bottom: 5px; font-weight: bold;" %>
    <%= form.text_field :search_name, value: params[:search_name], placeholder: "Type an employee name...", style: "padding: 5px; width: 250px;" %>
    <%= form.submit "Search", style: "padding: 5px 10px; cursor: pointer;" %>
    
    <% if params[:search_name].present? %>
      <%= link_to "Clear", memberships_path, style: "margin-left: 10px; color: red; text-decoration: none;" %>
    <% end %>
  </div>
<% end %>

<table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse; text-align: left;">
  <thead>
    <tr style="background-color: #f2f2f2;">
      <th>Employee</th>
      <th>Team</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @memberships.each do |membership| %>
      <tr>
        <td>
          <%= link_to "#{membership.employee.first_name} #{membership.employee.last_name}", membership_path(membership) %>
        </td>
        
        <td><%= membership.team.name %></td>
        
        <td>
          <div class="actions" style="display: flex; gap: 10px; align-items: center;">
            
            <%= button_to "Edit", edit_membership_path(membership), class: "btn btn-primary" %>
            
            <% unless membership.finished_at.present? %>
              <%= button_to "Finish Membership", membership_path(membership), 
                            method: :delete, 
                            data: { turbo_confirm: "Are you sure you want to finish this membership?" }, 
                            class: "btn btn-danger" %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
