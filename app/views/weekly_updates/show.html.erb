<div class="app-container">
  <div class="breadcrumb-nav">
    <%= link_to "← Back to Team Updates", team_weekly_updates_path(@weekly_update.team) %>
  </div>

  <header class="page-header">
    <div>
      <h1 class="page-title">Weekly Update Details</h1>
      <p class="page-subtitle">Update #<%= @weekly_update.id %> for <%= @weekly_update.team.name %></p>
    </div>

    <div class="header-actions">
      <%= link_to "Edit Content", edit_weekly_update_path(@weekly_update), class: "btn btn-dark" %>
      <%= button_to "Delete", weekly_update_path(@weekly_update),
          method: :delete,
          form: { style: "display: inline;" },
          data: { turbo_confirm: "Are you sure you want to delete this weekly update?" },
          class: "btn btn-danger-outline" %>
    </div>
  </header>

  <article class="card">
    <div class="detail-list">
      <div class="detail-row">
        <span class="detail-label">Team</span>
        <div>
          <span class="badge badge-primary" style="font-size: 0.9rem;"><%= @weekly_update.team.name %></span>
        </div>
      </div>

      <div class="detail-row">
        <span class="detail-label">Status</span>
        <div>
          <% badge_class = @weekly_update.status == "published" ? "badge-success" : "badge-warning" %>
          <span class="badge <%= badge_class %>"><%= @weekly_update.status.humanize %></span>
        </div>
      </div>

      <% if @weekly_update.published_date.present? %>
        <div class="detail-row">
          <span class="detail-label">Published Date</span>
          <span class="detail-value"><%= @weekly_update.published_date.strftime("%d/%m/%Y %H:%M") %></span>
        </div>
      <% end %>

      <div class="detail-row">
        <span class="detail-label">Content</span>
        <div class="content-body" style="margin-top: 0.25rem;">
          <%= simple_format(@weekly_update.content) %>
        </div>
      </div>
    </div>
  </article>
</div>