<div class="app-container">
  <div class="breadcrumb-nav">
    <%= link_to "← Back to Employee", employee_path(@employee) %>
  </div>

  <header class="page-header">
    <div>
      <h1 class="page-title">Edit Employee</h1>
      <p class="page-subtitle">Updating profile for <strong><%= @employee.first_name %> <%= @employee.last_name %></strong></p>
    </div>
  </header>

  <div class="form-card">
    <%= form_with model: @employee, data: { turbo: false } do |f| %>
      <div class="form-row">
        <div class="form-group">
          <%= f.label :first_name, "First name", class: "form-label" %>
          <%= f.text_field :first_name, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :last_name, "Last name", class: "form-label" %>
          <%= f.text_field :last_name, class: "form-control" %>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :role, "Role", class: "form-label" %>
        <%= f.text_field :role, class: "form-control" %>
      </div>

      <% if EmployeePolicy.new(Current.user, @employee).is_manager? %>
        <div class="form-group">
          <%= f.label :is_manager, "Is this employee a manager?", class: "form-label" %>
          <div class="radio-group">
            <label class="radio-option">
              <%= f.radio_button :is_manager, true %> Yes
            </label>
            <label class="radio-option">
              <%= f.radio_button :is_manager, false %> No
            </label>
          </div>
        </div>

        <div class="form-group">
          <%= f.label :manager_id, "Select Manager", class: "form-label" %>
          <%= f.collection_select :manager_id, @manager, :id, :full_name_with_role,
              { include_blank: "Not defined" },
              { class: "form-control" } %>
        </div>
      <% end %>

      <div class="form-actions">
        <%= f.submit "Save Changes", class: "btn btn-primary" %>
        <%= link_to "Cancel", employee_path(@employee), class: "link-muted" %>
      </div>
    <% end %>
  </div>
</div>