<div class="app-container">
  <div class="breadcrumb-nav">
    <%= link_to "← Back to All Employees", "/employees/all" %>
  </div>

  <header class="page-header">
    <div>
      <h1 class="page-title">New Employee</h1>
      <p class="page-subtitle">Create a new team member profile and user account</p>
    </div>
  </header>

  <div class="form-card">
    <%= form_with model: @employee, data: { turbo: false } do |f| %>
      <div class="form-row">
        <div class="form-group">
          <%= f.label :first_name, "First name", class: "form-label" %>
          <%= f.text_field :first_name, class: "form-control" %>
          <% if @employee.errors[:first_name].any? %>
            <div class="field-error"><%= @employee.errors.full_messages_for(:first_name).join(", ") %></div>
          <% end %>
        </div>

        <div class="form-group">
          <%= f.label :last_name, "Last name", class: "form-label" %>
          <%= f.text_field :last_name, class: "form-control" %>
          <% if @employee.errors[:last_name].any? %>
            <div class="field-error"><%= @employee.errors.full_messages_for(:last_name).join(", ") %></div>
          <% end %>
        </div>
      </div>

      <%= f.fields_for :user do |user_fields| %>
        <div class="form-group">
          <%= user_fields.label :email_address, "Email Address", class: "form-label" %>
          <%= user_fields.email_field :email_address, class: "form-control", placeholder: "employee@company.com" %>
          <% if @employee.errors["user.email_address"].any? %>
            <div class="field-error">Email <%= @employee.errors["user.email_address"].join(", ") %></div>
          <% end %>
        </div>

        <div class="form-row">
          <div class="form-group">
            <%= user_fields.label :password, "Password", class: "form-label" %>
            <%= user_fields.password_field :password, placeholder: "Leave empty for default password", class: "form-control" %>
          </div>

          <div class="form-group">
            <%= user_fields.label :password_confirmation, "Confirm Password", class: "form-label" %>
            <%= user_fields.password_field :password_confirmation, class: "form-control" %>
          </div>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :role, "Role", class: "form-label" %>
        <%= f.text_field :role, class: "form-control", placeholder: "e.g. Software Engineer" %>
        <% if @employee.errors[:role].any? %>
          <div class="field-error"><%= @employee.errors.full_messages_for(:role).join(", ") %></div>
        <% end %>
      </div>

      <div class="form-group">
        <%= f.label :is_manager, "Is this employee a manager?", class: "form-label" %>
        <div class="radio-group">
          <label class="radio-option">
            <%= f.radio_button :is_manager, true %> Yes
          </label>
          <label class="radio-option">
            <%= f.radio_button :is_manager, false, checked: true %> No
          </label>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :manager_id, "Select Manager", class: "form-label" %>
        <%= f.collection_select :manager_id, @manager, :id, :full_name_with_role,
            { include_blank: "Not defined" },
            { class: "form-control" } %>
      </div>

      <div class="form-actions">
        <%= f.submit "Create Employee", class: "btn btn-primary" %>
        <%= link_to "Cancel", "/employees/all", class: "link-muted" %>
      </div>
    <% end %>
  </div>
</div>