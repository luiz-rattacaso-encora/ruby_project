<h2>Form to new employee</h2>

<%= form_with model: @employee, data: { turbo: false } do |f| %>

  <p>
    <%= f.label :first_name, "First name:" %>
    <%= f.text_field :first_name %>
  </p>
  <% if @employee.errors[:first_name].any? %>
    <div style="color: red; font-size: 0.85rem; margin-top: -10px; margin-bottom: 10px;">
      <%= @employee.errors.full_messages_for(:first_name).join(", ") %>
    </div>
  <% end %>

  <p>
    <%= f.label :last_name, "Last name:" %>
    <%= f.text_field :last_name %>
  </p>
  <% if @employee.errors[:last_name].any? %>
    <div style="color: red; font-size: 0.85rem; margin-top: -10px; margin-bottom: 10px;">
      <%= @employee.errors.full_messages_for(:last_name).join(", ") %>
    </div>
  <% end %>

  <p>
    <%= f.label :role, "Role:" %>
    <%= f.text_field :role %>
  </p>
  <% if @employee.errors[:role].any? %>
    <div style="color: red; font-size: 0.85rem; margin-top: -10px; margin-bottom: 10px;">
      <%= @employee.errors.full_messages_for(:role).join(", ") %>
    </div>
  <% end %>

  <p>
    <%= f.label :is_manager, "Is this employee a manager?" %><br>
    <%= f.radio_button :is_manager, true %>
    <%= f.label :is_manager_true, "Yes" %>
    
    <%= f.radio_button :is_manager, false, checked: true %>
    <%= f.label :is_manager_false, "No" %>
  </p>

  <div class="field">
    <%= f.label :manager_id, "Select Manager" %>
    <%= f.collection_select :manager_id, @manager, :id, :full_name_with_role , include_blank: "Not defined" %>
  </div>

  <p>
    <%= f.submit %>
  </p>

<% end %>
