<div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 80vh; font-family: monospace; text-align: center;">
  
  <h1>Organizational Hierarchy</h1>

  <div style="margin: 20px 0; width: 100%; max-width: 600px;">
    <div style="margin-top: 20px;">
      <% @employee.reports_to.each do |manager| %>
        <div style="margin-bottom: 5px;">
          <%= link_to manager.full_name_with_role, employee_path(manager) %>
        </div>
        <div style="color: #666; margin-bottom: 5px;">|</div>
        <div style="color: #666; margin-bottom: 5px;">v</div>
      <% end %>

      <div style="font-weight: bold; background-color: #f0f0f0; padding: 6px 12px; display: inline-block; margin-top: 5px;">
      ---> <%= @employee.full_name_with_role %>
      </div>
    </div>
  </div>

  <hr style="width: 100%; max-width: 400px; margin: 20px 0;">

  <div>
    <%= link_to "Edit", edit_employee_path(@employee) %> |
    <%= link_to "Back", "/employees/all" %>
  </div>

</div>
