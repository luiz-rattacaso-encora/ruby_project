<div class="app-container">
  <div class="breadcrumb-nav">
    <%= link_to "← Back to All Employees", "/employees/all" %>
  </div>

  <header class="page-header">
    <div>
      <h1 class="page-title">Organizational Hierarchy</h1>
      <p class="page-subtitle">Reporting chain for <%= @employee.first_name %> <%= @employee.last_name %></p>
    </div>

    <div class="header-actions">
      <%= link_to "Edit Employee", edit_employee_path(@employee), class: "btn btn-outline" %>
    </div>
  </header>

  <div class="card">
    <div class="hierarchy-wrapper">
      <% @employee.reports_to.each do |manager| %>
        <div class="hierarchy-node">
          <%= link_to manager.full_name_with_role, employee_path(manager) %>
        </div>
        <div class="hierarchy-connector">
          <span>|</span>
          <span>↓</span>
        </div>
      <% end %>

      <div class="hierarchy-node is-current">
        <%= @employee.full_name_with_role %>
      </div>
    </div>
  </div>
</div>