<h2>Employees</h2>

<% @employees.each do |employee| %>
    <div>
        <p><strong><%= employee.name %></strong> - <%= employee.role %></p>
        <p>Team Members (<%= employee.team_members.count %>): </p>
        <ul>
            <% employee.team_members.each do |member| %>
                <li><%= member.name %> - <%= member.role %></li>
            <% end %>
        </ul>
        <hr>
        <br>
    </div>
<% end %>
