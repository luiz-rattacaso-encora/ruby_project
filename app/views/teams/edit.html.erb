<% content_for :title, "Editing team" %>

<div class="app-container">
  <div class="breadcrumb-nav">
    <%= link_to "← Back to Teams", teams_path %>
  </div>

  <header class="page-header">
    <div>
      <h1 class="page-title">Editing Team</h1>
      <p class="page-subtitle">Updating details for <strong><%= @team.name %></strong></p>
    </div>

    <div class="header-actions">
      <%= link_to "Show this team", @team, class: "btn btn-outline" %>
    </div>
  </header>

  <%= render "form", team: @team %>
</div>