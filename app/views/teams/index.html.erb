<% content_for :title, "Teams" %>

<div class="app-container">
  <% if notice.present? %>
    <div class="alert alert-notice"><%= notice %></div>
  <% end %>

  <div class="breadcrumb-nav">
    <%= link_to "← Back to Home", "/" %>
  </div>

  <header class="page-header">
    <div>
      <h1 class="page-title">Teams</h1>
      <p class="page-subtitle">Departments, squads, and their tech stacks</p>
    </div>

    <div class="header-actions">
      <%= link_to "+ New Team", new_team_path, class: "btn btn-primary" %>
    </div>
  </header>

  <section class="filter-box">
    <%= form_with url: teams_path, method: :get, local: true, class: "filter-form" do |form| %>
      <div style="flex: 1; min-width: 220px;">
        <%= form.label :search_name, "Search by team name", class: "form-label" %>
        <%= form.text_field :search_name, value: params[:search_name], placeholder: "Type a team name...", class: "form-control" %>
      </div>

      <div class="header-actions">
        <%= form.submit "Search", class: "btn btn-dark" %>
        <% if params[:search_name].present? %>
          <%= link_to "Clear", teams_path, class: "link-muted" %>
        <% end %>
      </div>
    <% end %>
  </section>

  <% if @teams.any? %>
    <div id="teams" class="card-stack">
      <% @teams.each do |team| %>
        <%= render team %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p>No teams found.</p>
      <small>Try adjusting your search or create a new team.</small>
    </div>
  <% end %>
</div>