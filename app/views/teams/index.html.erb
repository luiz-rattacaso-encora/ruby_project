<p style="color: green"><%= notice %></p>

<% content_for :title, "Teams" %>

<h1>Teams</h1>

<%= form_with url: teams_path, method: :get, local: true do |form| %>
  <div style="margin-bottom: 20px;">
    <%= form.label :search_name, "Search by team name:", style: "display: block; margin-bottom: 5px; font-weight: bold;" %>
    <%= form.text_field :search_name, value: params[:search_name], placeholder: "Type a team name...", style: "padding: 5px; width: 250px;" %>
    <%= form.submit "Search", style: "padding: 5px 10px; cursor: pointer;" %>
    
    <% if params[:search_name].present? %>
      <%= link_to "Clear", teams_path, style: "margin-left: 10px; color: red; text-decoration: none;" %>
    <% end %>
  </div>
<% end %>

<div id="teams">
  <% @teams.each do |team| %>
    <%= render team %>
    <p>
      <%= link_to "Show this team", team %>
    </p>
  <% end %>
</div>

<%= link_to "New team", new_team_path %>
