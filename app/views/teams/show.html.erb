<div class="app-container">

  <div class="breadcrumb-nav">
    <%= link_to "← Back to Teams", teams_path %>
  </div>

  <header class="page-header">
    <div>
      <h1 class="page-title"><%= @team.name %></h1>
      <p class="page-subtitle">Team details and weekly updates</p>
    </div>

    <div class="header-actions">
      <%= link_to "Weekly Updates", team_weekly_updates_path(@team), class: "btn btn-outline" %>
      <%= link_to "Edit this team", edit_team_path(@team), class: "btn btn-dark" %>
      <%= button_to "Destroy this team", @team,
          method: :delete,
          form: { style: "display: inline;" },
          data: { turbo_confirm: "Are you sure you want to delete this team?" },
          class: "btn btn-danger-outline" %>
    </div>
  </header>

  <%= render @team %>
</div>