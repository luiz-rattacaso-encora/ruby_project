<div class="form-card">
  <%= form_with(model: team) do |form| %>
    <% if team.errors.any? %>
      <div class="error-summary">
        <h4 class="error-summary-title">
          <%= pluralize(team.errors.count, "error") %> prohibited this team from being saved:
        </h4>
        <ul>
          <% team.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :name, "Team Name", class: "form-label" %>
      <%= form.text_field :name, class: "form-control", placeholder: "e.g. Platform Engineering" %>
    </div>

    <div class="form-group">
      <%= form.label :description, "Description", class: "form-label" %>
      <%= form.textarea :description, rows: 4, class: "form-control", placeholder: "What does this team focus on?" %>
    </div>

    <div class="form-group">
      <%= form.text_field :technologies,
        value: Array(form.object.technologies).join(", "),
        class: "form-control",
        placeholder: "e.g. Ruby on Rails, PostgreSQL, React" %>
    </div>

    <div class="form-actions">
      <%= form.submit class: "btn btn-primary" %>
      <%= link_to "Cancel", team.persisted? ? team_path(team) : teams_path, class: "link-muted" %>
    </div>
  <% end %>
</div>