<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f8f9fa; padding: 32px 16px; color: #212529;">
  <div style="max-width: 480px; margin: 0 auto; background-color: #ffffff; border: 1px solid #dee2e6; border-radius: 8px; padding: 24px;">
    <h2 style="margin-top: 0; margin-bottom: 8px; font-size: 20px; font-weight: 600;">
      Reset your password
    </h2>
    
    <p style="margin-top: 0; margin-bottom: 20px; font-size: 14px; color: #6c757d;">
      You requested a password reset for your account.
    </p>

    <p style="margin-bottom: 24px; font-size: 15px; line-height: 1.5;">
      You can reset your password by clicking the button below:
    </p>

    <div style="margin-bottom: 24px;">
      <%= link_to "Reset Password",
          edit_password_url(@user.password_reset_token),
          style: "display: inline-block; background-color: #0d6efd; color: #ffffff; text-decoration: none; font-weight: 500; font-size: 14px; padding: 10px 18px; border-radius: 6px;" %>
    </div>

    <div style="border-top: 1px solid #dee2e6; padding-top: 16px; font-size: 13px; color: #6c757d;">
      This link will expire in <strong><%= distance_of_time_in_words(0, @user.password_reset_token_expires_in) %></strong>.
    </div>
  </div>
</div>
